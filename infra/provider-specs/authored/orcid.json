{
  "info": {
    "description": "Public researcher identifier, affiliation, and work records. Authored from https://info.orcid.org/documentation/api-tutorials/",
    "title": "ORCID Public API v3.0",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/expanded-search/": {
      "get": {
        "operationId": "orcidExpandedSearch",
        "parameters": [
          {
            "description": "Solr/Lucene ORCID search expression.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Zero-based result offset.",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Number of rows to return, maximum 1000.",
            "in": "query",
            "name": "rows",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Successful provider response."
          }
        },
        "summary": "Search ORCID records and return expanded summary fields."
      }
    },
    "/search/": {
      "get": {
        "operationId": "orcidSearch",
