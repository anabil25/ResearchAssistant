            "name": "start",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Number of rows to return, maximum 1000.",
            "in": "query",
            "name": "rows",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Successful provider response."
          }
        },
        "summary": "Search ORCID records and return matching identifiers."
      }
    },
