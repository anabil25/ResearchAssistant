{
  "components": {
    "schemas": {
      "ConnectorCatalogResponse": {
        "additionalProperties": false,
        "properties": {
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorDescriptor"
            },
            "title": "Connectors",
            "type": "array"
          },
          "schema_version": {
            "default": "research-assistant.connector-gateway.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "connectors"
        ],
        "title": "ConnectorCatalogResponse",
        "type": "object"
      },
      "ConnectorDescriptor": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/PublicConnectorSource"
          }
        },
        "required": [
          "id",
          "description",
          "capabilities"
        ],
        "title": "ConnectorDescriptor",
        "type": "object"
      },
      "ConnectorHealthResponse": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "default": "research-assistant.connector-gateway.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "default": "research-assistant-connector-adapter",
