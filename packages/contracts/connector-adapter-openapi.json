          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/LiteratureConnectorSource"
          }
        },
        "required": [
          "query",
          "source"
        ],
        "title": "LiteratureSearchRequest",
        "type": "object"
      },
