        "enum": [
          "pubmed",
          "europe_pmc",
          "crossref",
          "openalex",
          "arxiv",
          "clinical_trials",
          "grants_gov",
          "nih_reporter",
          "datacite",
          "orcid",
          "ror",
          "semantic_scholar"
