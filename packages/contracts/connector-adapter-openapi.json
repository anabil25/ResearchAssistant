            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ConnectorHealthResponse",
        "type": "object"
      },
      "ConnectorSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "ConnectorSearchRequest",
        "type": "object"
      },
      "ConnectorSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "notice": {
            "default": "Metadata only. Verify source rights, current status, and full text before using a record as research evidence.",
