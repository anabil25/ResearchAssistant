{
  "components": {
    "schemas": {
      "ConnectorResult": {
        "additionalProperties": false,
        "properties": {
          "notice": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "retrieved_from": {
            "format": "uri",
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "terms_url": {
            "format": "uri",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "source",
          "query",
          "records",
          "terms_url",
          "retrieved_from",
          "warnings",
          "notice"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Bounded deterministic normalization for public research metadata providers.",
    "title": "Research Assistant normalized connectors",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/connectors/arxiv/lookup": {
      "get": {
        "description": "Preprint metadata for supported disciplines.",
        "operationId": "arxivLookup",
        "parameters": [
          {
            "in": "query",
            "name": "identifier",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorResult"
                }
              }
            },
            "description": "Normalized public metadata evidence."
          },
          "422": {
            "description": "Invalid connector input."
          },
          "502": {
            "description": "Upstream provider unavailable."
          }
        },
        "summary": "arXiv lookup",
        "tags": [
          "arxiv"
        ]
      }
    },
