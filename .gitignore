# Azure Developer CLI environment state
.azure/*
!.azure/.gitignore
!.azure/deployment-plan.md

# Secrets and local configuration
.env
.env.*
!.env.example
agents/.env
agents/.foundry/
agents/.release/source-tree.json

# Python
.venv/
.venv-provision/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
dist/
build/
*.egg-info/

# Node / Next / Playwright
**/node_modules/
apps/web/.next/
# Invocation-unique Next build directories used by concurrent E2E gate runs
# (see apps/web/scripts/gate-invocation-paths.mjs).
apps/web/.next-gate/
apps/web/out/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/
apps/web/.swc/

# Browser MCP session dumps and ad-hoc screenshots captured during debugging
.playwright-mcp/
/*.png

# Generated infrastructure artifacts
infra/main.json
infra/*.arm.json

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/
