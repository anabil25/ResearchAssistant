{
  "components": {
    "schemas": {
      "ConnectorCatalogResponse": {
        "additionalProperties": false,
        "properties": {
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorDescriptor"
            },
            "title": "Connectors",
            "type": "array"
          },
          "schema_version": {
            "default": "research-assistant.connector-gateway.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "connectors"
        ],
        "title": "ConnectorCatalogResponse",
        "type": "object"
      },
      "ConnectorDescriptor": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/PublicConnectorSource"
          }
        },
        "required": [
          "id",
          "description",
          "capabilities"
        ],
        "title": "ConnectorDescriptor",
        "type": "object"
      },
      "ConnectorHealthResponse": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "default": "research-assistant.connector-gateway.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "default": "research-assistant-connector-adapter",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ConnectorHealthResponse",
        "type": "object"
      },
      "ConnectorSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "notice": {
            "default": "Metadata only. Verify source rights, current status, and full text before using a record as research evidence.",
            "title": "Notice",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Records",
            "type": "array"
          },
          "retrieved_from": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Retrieved From",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PublicConnectorSource"
          },
          "terms_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Terms Url",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "source",
          "query",
          "records",
          "terms_url",
          "retrieved_from"
        ],
        "title": "ConnectorSearchResponse",
        "type": "object"
      },
      "GrantConnectorSource": {
        "enum": [
          "grants_gov",
          "nih_reporter",
          "crossref",
          "openalex"
        ],
        "title": "GrantConnectorSource",
        "type": "string"
      },
      "GrantSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/GrantConnectorSource"
          }
        },
        "required": [
          "query",
          "source"
        ],
        "title": "GrantSearchRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiteratureConnectorSource": {
        "enum": [
          "pubmed",
          "europe_pmc",
          "crossref",
          "openalex",
          "arxiv",
          "clinical_trials",
          "datacite",
          "semantic_scholar"
        ],
        "title": "LiteratureConnectorSource",
        "type": "string"
      },
      "LiteratureSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/LiteratureConnectorSource"
          }
        },
        "required": [
          "query",
          "source"
        ],
        "title": "LiteratureSearchRequest",
        "type": "object"
      },
      "MatchingConnectorSource": {
        "enum": [
          "openalex",
          "orcid",
          "ror",
          "nih_reporter"
        ],
        "title": "MatchingConnectorSource",
        "type": "string"
      },
      "MatchingSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/MatchingConnectorSource"
          }
        },
        "required": [
          "query",
          "source"
        ],
        "title": "MatchingSearchRequest",
        "type": "object"
      },
      "PublicConnectorSource": {
        "enum": [
          "pubmed",
          "europe_pmc",
          "crossref",
          "openalex",
          "arxiv",
          "clinical_trials",
          "grants_gov",
          "nih_reporter",
          "datacite",
          "orcid",
          "ror",
          "semantic_scholar"
        ],
        "title": "PublicConnectorSource",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Bounded public metadata operations for APIM and MCP exposure.",
    "title": "Research Assistant Connector Adapter",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/connectors": {
      "get": {
        "operationId": "listResearchConnectors",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorCatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Connectors",
        "tags": [
          "catalog"
        ]
      }
    },
