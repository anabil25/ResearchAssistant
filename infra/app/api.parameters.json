{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "azdEnvironmentName": { "value": "${AZURE_ENV_NAME}" },
    "tags": { "value": "${AZURE_TAGS}" },
    "name": { "value": "${SERVICE_API_NAME}" },
    "location": { "value": "${AZURE_APPLICATION_LOCATION}" },
    "containerAppsEnvironmentName": { "value": "${AZURE_CONTAINER_ENVIRONMENT_NAME}" },
    "containerRegistryName": { "value": "${AZURE_CONTAINER_REGISTRY_NAME}" },
    "imageName": { "value": "${SERVICE_API_IMAGE_NAME}" },
    "apiIdentityResourceId": { "value": "${AZURE_MANAGED_IDENTITY_RESOURCE_ID}" },
    "apiIdentityClientId": { "value": "${AZURE_MANAGED_IDENTITY_CLIENT_ID}" },
    "applicationResourceToken": { "value": "${AZURE_APPLICATION_RESOURCE_TOKEN}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "openAIEndpoint": { "value": "${AZURE_OPENAI_ENDPOINT}" },
    "searchEndpoint": { "value": "${AZURE_SEARCH_ENDPOINT}" },
    "searchIndexName": { "value": "${AZURE_SEARCH_INDEX_NAME}" },
    "embeddingDeploymentName": { "value": "${AZURE_AI_EMBEDDING_DEPLOYMENT_NAME}" },
    "documentIntelligenceEndpoint": { "value": "${AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT}" },
    "cosmosEndpoint": { "value": "${AZURE_COSMOS_ENDPOINT}" },
    "cosmosDatabaseName": { "value": "${AZURE_COSMOS_DATABASE}" },
    "storageAccountName": { "value": "${AZURE_STORAGE_ACCOUNT_NAME}" },
    "storageBlobEndpoint": { "value": "${AZURE_STORAGE_BLOB_ENDPOINT}" },
    "sourceContainerName": { "value": "${AZURE_STORAGE_SOURCE_CONTAINER}" },
    "artifactContainerName": { "value": "${AZURE_STORAGE_ARTIFACT_CONTAINER}" },
    "agentStudioCosmosDatabaseName": { "value": "${AZURE_COSMOS_AGENT_STUDIO_DATABASE}" },
    "agentStudioMetadataContainerName": { "value": "${AZURE_COSMOS_AGENT_STUDIO_METADATA_CONTAINER}" },
    "agentStudioMemoryContainerName": { "value": "${AZURE_COSMOS_AGENT_STUDIO_MEMORY_CONTAINER}" },
    "agentStudioAuditContainerName": { "value": "${AZURE_COSMOS_AGENT_STUDIO_AUDIT_CONTAINER}" },
    "agentStudioCatalogContainerName": { "value": "${AZURE_COSMOS_AGENT_STUDIO_CATALOG_CONTAINER}" },
    "agentStudioBundleContainerName": { "value": "${AZURE_STORAGE_AGENT_STUDIO_BUNDLE_CONTAINER}" },
    "appInsightsConnectionString": { "value": "${APPLICATIONINSIGHTS_CONNECTION_STRING}" },
    "connectorGatewayUrl": { "value": "${RESEARCH_CONNECTOR_GATEWAY_URL}" },
    "connectorGatewayTokenScope": { "value": "${RESEARCH_CONNECTOR_GATEWAY_TOKEN_SCOPE}" },
    "workspaceTenantId": { "value": "${RESEARCH_WORKSPACE_TENANT_ID}" },
    "workspaceProjectId": { "value": "${RESEARCH_WORKSPACE_PROJECT_ID}" },
    "entraAuthEnforced": { "value": "${RESEARCH_ENTRA_AUTH_ENFORCED}" },
    "entraTenantId": { "value": "${RESEARCH_ENTRA_TENANT_ID}" },
    "entraApiClientId": { "value": "${RESEARCH_ENTRA_API_CLIENT_ID}" }
  }
}