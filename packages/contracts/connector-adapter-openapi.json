            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Records",
            "type": "array"
          },
          "retrieved_from": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Retrieved From",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PublicConnectorSource"
          },
          "terms_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Terms Url",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "source",
          "query",
          "records",
          "terms_url",
          "retrieved_from"
        ],
        "title": "ConnectorSearchResponse",
        "type": "object"
      },
