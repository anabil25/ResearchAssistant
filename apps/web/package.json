{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "npm run build && playwright test",
    "verify:e2e-runtime-coverage": "node scripts/verify-playwright-runtime-coverage.mjs",
    "test:e2e:gate": "node scripts/run-e2e-coverage-gate.mjs",
    "generate:contracts": "openapi-typescript ../../packages/contracts/openapi.json -o src/lib/generated-api.ts",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.4",
    "clsx": "2.1.1",
    "harden-react-markdown": "1.1.8",
    "lucide-react": "1.23.0",
    "next": "16.3.0-preview.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@emnapi/wasi-threads": "1.2.2",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0-preview.6",
    "jest": "30.2.0",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "30.2.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.12",
    "js-yaml": "4.3.0",
    "next": {
      "sharp": "0.35.0"
    }
  }
}
